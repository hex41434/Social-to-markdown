{
  "manifest_version": 3,
  "name": "AiFa Social",
  "version": "0.2.0",
  "description": "Capture explicitly requested LinkedIn Saved Posts into the local Obsidian bridge.",
  "action": {
    "default_title": "Open AiFa Social",
    "default_icon": {
      "32": "icon32.png",
      "64": "icon64.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/my-items/saved-posts/*"
      ],
      "js": [
        "linkedin-scroll.js",
        "linkedin-capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
